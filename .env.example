# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Redis (BullMQ) ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Providers ────────────────────────────────────────────────────────────
# The production app pipeline currently uses Anthropic/Claude for structured
# extraction, interviews, requirements, routing, and developer briefs.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: the standalone AI smoke harness can run with Claude, Groq, or Kimi.
# Pick one provider with AI_SMOKE_PROVIDER=claude|groq|kimi, or omit it and the
# script will choose the first configured key in that order.
AI_SMOKE_PROVIDER=claude
GROQ_API_KEY=gsk_...
KIMI_API_KEY=sk-...
# Kimi is served through Moonshot's OpenAI-compatible API.
KIMI_BASE_URL=https://api.moonshot.ai/v1
# Optional model overrides:
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# GROQ_MODEL=llama-3.3-70b-versatile
# KIMI_MODEL=kimi-k2.6

# ─── OpenAI (Realtime Voice Interviews) ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Jira ────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_DEFAULT_PROJECT=SCRUM
# Custom field ID for story points (find via Jira Admin > Issues > Custom Fields)
# Common values: customfield_10016, story_points — leave blank to skip
# JIRA_STORY_POINTS_FIELD=customfield_10016

# ─── Slack Notifications ─────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Scrum Relief Repo Reader ────────────────────────────────────────────────
# direct = read GitHub with GITHUB_READONLY_TOKEN
# composio = read GitHub through Composio proxy execute
REPO_READER_PROVIDER=direct
GITHUB_READONLY_TOKEN=github_pat_readonly_contents_metadata
COMPOSIO_API_KEY=...
COMPOSIO_GITHUB_CONNECTED_ACCOUNT_ID=ca_github_user_...
# Optional override; default is https://backend.composio.dev/api/v3.1
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1

# ─── Email Delivery ─────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Ellavox <onboarding@resend.dev>"

# ─── Webhook Auth ────────────────────────────────────────────────────────────
# Static secret for authenticating incoming webhooks.
# Callers must send this as x-webhook-secret header or Bearer token.
WEBHOOK_SECRET=your-webhook-secret-here

# Bearer token for /api/cron/maintenance.
CRON_SECRET=your-cron-secret-here

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
VERCEL_REGION=iad1

# ─── n8n Integration ─────────────────────────────────────────────────────────
# n8n watches Google Drive and forwards transcripts via POST /api/webhooks/n8n.
# No extra env vars needed — uses WEBHOOK_SECRET above for auth.
# See docs/n8n-google-drive-setup.md for full setup instructions.

# ─── Google Meet Provider (Phase 1) ─────────────────────────────────────────
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/meet-transcripts

# ─── Zoom Provider (Phase 3) ────────────────────────────────────────────────
# ZOOM_CLIENT_ID=...
# ZOOM_CLIENT_SECRET=...
# ZOOM_ACCOUNT_ID=...
# ZOOM_WEBHOOK_VERIFICATION_TOKEN=...

# ─── MS Teams Provider (Phase 3) ────────────────────────────────────────────
# AZURE_TENANT_ID=...
# AZURE_CLIENT_ID=...
# AZURE_CLIENT_SECRET=...
